# Copie para .env.local e preencha. Nunca versione o .env.local.

# Segredo que assina o cookie de sessão dos admins (HMAC-SHA256). Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSAO_SEGREDO=

# Connection string *pooled* do Neon. Vazio = banco local PGlite em dados/pglite.
DATABASE_URL=
